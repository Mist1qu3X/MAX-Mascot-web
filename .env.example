# Переменные окружения сервера. В Dokploy — вкладка Environment.

# Публичный адрес страницы, без слэша в конце. От него строятся ссылки
# в QR и ссылки на кадры, которые скачивает kie.ai. Без него сервер
# считает себя локальным и строит адреса от IP компьютера в Wi-Fi.
PUBLIC_URL=https://mascot.alavenir.tech

# Пароль для записи: POST /shot, /upload, /i/…, прокси /kie/…
# На хостинге обязателен — иначе любой заставит сервер качать что угодно.
# Должен совпадать с VITE_STICKER_TOKEN в .env.local панели.
SHOT_TOKEN=

# База MySQL для статистики генераций. На хостинге значения уже заданы в
# Dokploy — сюда их не переписывать и в репозиторий не класть. Без DB_HOST
# статистика выключена, страница и QR работают как обычно.
# Для разработки: docker compose up -d и значения из docker-compose.yml.
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# Необязательные — значения по умолчанию подходят:
# PORT=8787                порт внутри контейнера
# BUDGET_MB=150            сколько памяти отдать под картинки
# KEEP=200                 сколько последних картинок держать
# MAX_UPLOAD_MB=12         предел на один кадр от панели
# DOWNLOAD_TIMEOUT_MS=15000  предел на скачивание картинки с kie.ai
# WAIT_FOR_COPY_MS=2500    сколько телефон ждёт копию картинки на сервере,
#                          прежде чем его отправят за ней на kie.ai
